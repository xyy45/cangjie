  "source": {
    "code": "func sumPositive(values: Array<Int64>): Int64 {\n    var index: Int64 = 0\n    var total: Int64 = 0\n    while (index < values.size) {\n        let value = values[index]\n        if (value > 0) {\n            total = total + value\n        }\n        index = index + 1\n    }\n    return total\n}\nmain(): Int64 {\n    println(sumPositive([2, -3, 4, 5]))\n    println(sumPositive([7]))\n    println(sumPositive([-2, -1]))\n    return 0\n}\n",
